// Reuse existing CSD3 environments for RNA analysis.

process {
    withLabel: rna_tools {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/rna'
    }

    withLabel: rna_report {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/rna_report'
    }

    withName: NANOSTAT {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/rna'
        cpus = 1
        memory = '16 GB'
    }

    withName: CUTADAPT {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/rna'
    }

    withName: MINIMAP2 {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/alignment'
        memory = '32 GB'
    }
}

// Use micromamba to activate the existing RNA environments.
conda.useMicromamba = true

// Run RNA Nextflow child jobs on icelake.
process.queue = 'icelake'


// FLAIR3 transcript reconstruction.
process {
    withName: FLAIR_TRANSCRIPTOME {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/flair3'
        cpus = 4
        memory = '32 GB'
    }
}

process {
    withName: 'RNA_WORKFLOW:NANOSTAT' {
        time = '2h'
    }
}

process {
    withName: 'RNA_WORKFLOW:PYCHOPPER' {
        time = '10h'
    }
}

// Walltime allocations for RNA reconstruction.
process {
    withName: 'RNA_WORKFLOW:MINIMAP2' {
        time = '8h'
    }
    withName: 'RNA_WORKFLOW:STRINGTIE_UNGUIDED' {
        time = '6h'
    }
    withName: 'RNA_WORKFLOW:STRINGTIE_MERGE' {
        time = '2h'
    }
    withName: 'RNA_WORKFLOW:STRINGTIE_REQUANT' {
        time = '6h'
    }
    withName: 'RNA_WORKFLOW:COMBINE_REQUANT_GTFS' {
        time = '1h'
    }
    withName: 'RNA_WORKFLOW:FINAL_HTML_REPORT' {
        time = '2h'
    }
}


// RNA junction analysis: use installed alignment environment on CSD3.
process {
    withName: 'RNA_WORKFLOW:INDEX_BAM' {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/alignment'
        cpus = 2
        memory = '8 GB'
        time = '2h'
    }
    withName: 'RNA_WORKFLOW:EXTRACT_SPLICE_JUNCTIONS' {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/alignment'
        cpus = 2
        memory = '12 GB'
        time = '2h'
    }
    withName: 'RNA_WORKFLOW:COMPARE_SPLICE_JUNCTIONS' {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/alignment'
        cpus = 1
        memory = '2 GB'
        time = '30m'
    }

    withName: 'RNA_WORKFLOW:ANNOTATE_SPLICE_JUNCTIONS' {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/alignment'
        cpus = 1
        memory = '6 GB'
        time = '30m'
    }

}


// Junction figure process configuration (2026-10-30)
params.rna_plot_rscript = '/rds-d6/user/vpc25/hpc-work/envs/rna_report/bin/Rscript'
process {
    withName: 'RNA_WORKFLOW:PLOT_JUNCTION_FIGURES' {
        queue = 'icelake'
        cpus = 2
        memory = '8 GB'
        time = '60m'
    }
}
