// Settings shared across all execution environments.

process {
    withLabel: wf_cnv {
        container = 'ontresearch/wf-cnv:sha428cb19e51370020ccf29ec2af4eead44c6a17c2'
    }

    withLabel: alignment {
        conda = "${projectDir}/envs/alignment.yml"
    }

    withLabel: samtools {
        conda = "${projectDir}/envs/alignment.yml"
    }

    withLabel: bcftools {
        conda = "${projectDir}/envs/bcftools.yml"
    }

    withLabel: sniffles {
        conda = "${projectDir}/envs/sniffles.yml"
    }
    withLabel: clair3 {
        conda = "${projectDir}/envs/clair3.yml"
    }

    withLabel: python {
        conda = "${projectDir}/envs/python.yml"
    }

}

// RNA workflow settings
process {
    withLabel: rna_tools {
        conda = "${projectDir}/envs/rna.yml"
    }

    withName: NANOSTAT {
        conda = "${projectDir}/envs/rna.yml"
        cpus = 1
        memory = '2 GB'
    }

    withName: CUTADAPT {
        conda = "${projectDir}/envs/rna.yml"
        cpus = 4
        memory = '4 GB'
    }

    withName: PYCHOPPER {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/neb-pychopper'
        cpus = 4
        memory = '8 GB'
    }

    withName: MINIMAP2 {
        conda = "${projectDir}/envs/alignment.yml"
        cpus = 4
        memory = '8 GB'
    }
}

// RAPID RNA reporting environment
process {
    withLabel: rna_report {
        conda = "${projectDir}/envs/rna_report.yml"
    }
}
