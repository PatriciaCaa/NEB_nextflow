// HPC execution settings.

process.executor = 'slurm'

process {
    withLabel: vep {
        container = 'ensemblorg/ensembl-vep:release_116.2'
    }
}

singularity.enabled = true
conda.enabled = true

// Default Slurm resources for the NEB workflow.
process.queue = 'icelake'
process.clusterOptions = '--account=RYTEN-SL3-CPU'

// Use Micromamba for environments on CSD3.
conda.useMicromamba = true

process.beforeScript = '''
export MAMBA_ROOT_PREFIX=/rds-d6/user/vpc25/hpc-work
export PATH=/rds-d6/user/vpc25/hpc-work/tools/micromamba/bin:$PATH
'''
