// Optional execution reporting for DNA and RNA workflows.
// Load explicitly with -c conf/reproducibility.config.
// Generates a process trace, HTML execution report and timeline.
params.provenance_dir = "${projectDir}/results/reproducibility"

trace {
    enabled = true
    file = "${params.provenance_dir}/nextflow_trace.txt"
}

report {
    enabled = true
    file = "${params.provenance_dir}/nextflow_report.html"
}

timeline {
    enabled = true
    file = "${params.provenance_dir}/nextflow_timeline.html"
}
