// Shared Nextflow execution reporting for DNA and RNA.
params.provenance_dir = "${projectDir}/results/reproducibility"

trace {
    enabled = true
    file = "${params.provenance_dir}/nextflow_trace.txt"
}

report {
    enabled = true
    file = "${params.provenance_dir}/nextflow_report.html"
}

timeline {
    enabled = true
    file = "${params.provenance_dir}/nextflow_timeline.html"
}
