// CSD3 configuration for RNA splice-junction validation.
// Defines Slurm resources and installed Conda environments
// for BAM indexing, junction extraction and comparison.

process {
    executor = 'slurm'
    queue = 'icelake'

    withName: INDEX_BAM {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/alignment'
        cpus = 2
        memory = '8 GB'
        time = '2h'
    }

    withName: EXTRACT_SPLICE_JUNCTIONS {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/alignment'
        cpus = 2
        memory = '8 GB'
        time = '2h'
    }

    withName: COMPARE_SPLICE_JUNCTIONS {
        conda = '/rds-d6/user/vpc25/hpc-work/envs/alignment'
        cpus = 1
        memory = '2 GB'
        time = '30m'
    }
}

conda.enabled = true
conda.useMicromamba = true
